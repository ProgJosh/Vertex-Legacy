{
  "name": "@vertex/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "generate": "node ../../scripts/with-root-env.mjs exec prisma generate",
    "migrate": "node ../../scripts/with-root-env.mjs exec prisma migrate deploy",
    "migrate:dev": "node ../../scripts/with-root-env.mjs exec prisma migrate dev",
    "migrate:deploy": "node ../../scripts/with-root-env.mjs exec prisma migrate deploy",
    "seed": "node ../../scripts/with-root-env.mjs exec tsx prisma/seed.ts",
    "reset": "node ../../scripts/with-root-env.mjs exec prisma migrate reset --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@vertex/config": "workspace:*",
    "@vertex/types": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

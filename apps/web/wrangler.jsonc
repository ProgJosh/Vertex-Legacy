{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vertex-legacy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "AUTH_PROVIDER": "auth0",
    "AUTH0_AUDIENCE": "https://api.vertex-legacy.com",
    "INTERNAL_API_URL": "https://api-production-8c96.up.railway.app/v1",
    "NEXT_PUBLIC_API_URL": "https://api-production-8c96.up.railway.app/v1",
    "WEB_ORIGIN": "https://vertex-legacy.joshua27emmanuel30.workers.dev",
  },
}

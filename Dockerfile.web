FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @vertex/web build

FROM node:24-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup --system vertex && adduser --system --ingroup vertex vertex
COPY --from=build --chown=vertex:vertex /app/apps/web/.next/standalone ./
COPY --from=build --chown=vertex:vertex /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=vertex:vertex /app/apps/web/public ./apps/web/public
USER vertex
EXPOSE 3000
CMD ["node", "apps/web/server.js"]

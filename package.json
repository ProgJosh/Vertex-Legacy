{
  "name": "vertex-legacy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "db:generate": "corepack pnpm --filter @vertex/database generate",
    "db:migrate": "corepack pnpm --filter @vertex/database migrate",
    "db:seed": "corepack pnpm --filter @vertex/database seed",
    "db:reset": "corepack pnpm --filter @vertex/database reset"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pnpm": "10.17.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
